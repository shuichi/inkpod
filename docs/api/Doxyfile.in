PROJECT_NAME           = "Inkpod FFI API"
PROJECT_NUMBER         = "ABI v30"
PROJECT_BRIEF          = "Rust Core C ABI リファレンス"
OUTPUT_DIRECTORY       = "@INKPOD_API_DOCS_OUTPUT_DIRECTORY@"
OUTPUT_LANGUAGE        = Japanese

CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = "@INKPOD_REPOSITORY_ROOT@"
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
MULTILINE_CPP_IS_BRIEF = YES
OPTIMIZE_OUTPUT_FOR_C  = YES
TYPEDEF_HIDES_STRUCT   = YES
MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 3
AUTOLINK_SUPPORT       = YES

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_SCOPE_NAMES       = NO
SHOW_INCLUDE_FILES     = YES
SHOW_USED_FILES        = YES
SHOW_FILES             = YES
SHOW_NAMESPACES        = NO

INPUT                  = "@INKPOD_REPOSITORY_ROOT@/include/inkpod/core_ffi.h" \
                         "@INKPOD_REPOSITORY_ROOT@/docs/ffi.md"
FILE_PATTERNS          = *.h *.md
RECURSIVE              = NO
USE_MDFILE_AS_MAINPAGE = "@INKPOD_REPOSITORY_ROOT@/docs/ffi.md"

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = NO
REFERENCES_RELATION    = NO

QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = NO
WARN_FORMAT            = "$file:$line: $text"

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_COLORSTYLE        = LIGHT
DISABLE_INDEX          = NO
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = NO
TREEVIEW_WIDTH         = 280
ENUM_VALUES_PER_LINE   = 1
HTML_EXTRA_STYLESHEET  = "@DOXYGEN_AWESOME_CSS_DIRECTORY@/doxygen-awesome.css" \
                         "@CMAKE_CURRENT_LIST_DIR@/inkpod-doxygen.css"

GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO
GENERATE_DOCBOOK       = NO

HAVE_DOT               = NO
CLASS_GRAPH            = NO
DIRECTORY_GRAPH        = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
MERMAID_RENDER_MODE    = CLI

SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO
EXTERNAL_SEARCH        = NO
