            MENUITEM "塗り", IDM_VECTOR_SELECT_FILL
        END
        MENUITEM "ベクターをラスタライズ...", IDM_VECTOR_RASTERIZE
        MENUITEM "ラスターをベクター化...", IDM_VECTOR_VECTORIZE
        MENUITEM SEPARATOR
        MENUITEM "グラデーション...", IDM_EFFECT_GRADIENT
        MENUITEM "エアブラシ...", IDM_EFFECT_AIRBRUSH
        MENUITEM "境界色エアブラシ...", IDM_EFFECT_BOUNDARY_AIRBRUSH
