        MENUITEM "プロパティ...", IDM_PLANE_PROPERTIES
    END
    POPUP "色(&C)"
    BEGIN
        MENUITEM "描画色（RGB/HSV・RGBA8/16）...", IDM_COLOR_EDITOR
        MENUITEM "Windows色選択...", IDM_COLOR_CHOOSE
