        BEGIN
            MENUITEM "最上位の非透明プレーン", IDM_COLOR_SOURCE_TOPMOST
            MENUITEM "選択中プレーン", IDM_COLOR_SOURCE_SELECTED
            MENUITEM "合成表示色", IDM_COLOR_SOURCE_COMPOSITE
            MENUITEM "ライトテーブル最上位色", IDM_COLOR_SOURCE_LIGHT_TABLE
