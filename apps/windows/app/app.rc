#include <windows.h>
#include "app_version.h"
#include "resource.h"

#pragma code_page(65001)

1 RT_MANIFEST "app.manifest"
IDI_APP_ICON ICON "../package/Assets/app.ico"
IDR_ABOUT_ICON_88_PNG RCDATA "../package/Assets/AppList.scale-200.png"
IDR_ABOUT_ICON_256_PNG RCDATA "../package/Assets/AppList.targetsize-256.png"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION INKPOD_VERSION_RESOURCE
 PRODUCTVERSION INKPOD_VERSION_RESOURCE
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041104b0"
        BEGIN
            VALUE "CompanyName", "inkpod contributors\0"
            VALUE "FileDescription", "アニメーション彩色のための制作アプリ\0"
            VALUE "FileVersion", INKPOD_VERSION_STRING "\0"
            VALUE "InternalName", "inkpod\0"
            VALUE "OriginalFilename", "inkpod.exe\0"
            VALUE "ProductName", "inkpod\0"
            VALUE "ProductVersion", INKPOD_VERSION_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0411, 1200
    END
END

STRINGTABLE
BEGIN
    IDS_APP_TITLE "inkpod"
    IDS_MAIN_WINDOW_CLASS "InkpodMainWindow"
    IDS_APP_VERSION INKPOD_VERSION_STRING
    IDS_ABOUT_DESCRIPTION "Inkpod is a GPU-accelerated painting engine with vector-based strokes for non-destructive editing."
    IDS_ABOUT_COPYRIGHT "© Shuichi Kurabayashi"
END

IDR_MAIN_MENU MENU
BEGIN
    POPUP "ファイル(&F)"
    BEGIN
        MENUITEM "新規セル(&N)\tCtrl+N", IDM_FILE_NEW
        MENUITEM "開く(&O)...\tCtrl+O", IDM_FILE_OPEN
        MENUITEM "保存(&S)\tCtrl+S", IDM_FILE_SAVE
        MENUITEM "名前を付けて保存(&A)...", IDM_FILE_SAVE_AS
        MENUITEM "復帰(&R)", IDM_FILE_REVERT
        MENUITEM "Recoveryを保存(&V)", IDM_FILE_AUTOSAVE_NOW
        MENUITEM "Recoveryを開く(&Y)...", IDM_FILE_OPEN_RECOVERY
        MENUITEM SEPARATOR
        MENUITEM "終了(&X)", IDM_APP_EXIT
    END
    POPUP "編集(&E)"
    BEGIN
        MENUITEM "元に戻す(&U)\tCtrl+Z", IDM_EDIT_UNDO
        MENUITEM "やり直し(&R)\tCtrl+Y", IDM_EDIT_REDO
        MENUITEM SEPARATOR
        MENUITEM "コピー(&C)\tCtrl+C", IDM_EDIT_COPY
        MENUITEM "貼り付け(&P)\tCtrl+V", IDM_EDIT_PASTE
        MENUITEM "画像を左右反転", IDM_EDIT_MIRROR_HORIZONTAL
    END
    POPUP "表示(&V)"
    BEGIN
        MENUITEM "拡大(&I)", IDM_VIEW_ZOOM_IN
        MENUITEM "縮小(&O)", IDM_VIEW_ZOOM_OUT
        MENUITEM "全体表示(&F)", IDM_VIEW_FIT
        MENUITEM "ピクセル等倍(&1)", IDM_VIEW_ONE_TO_ONE
        MENUITEM SEPARATOR
        MENUITEM "表示を左右反転", IDM_VIEW_FLIP_HORIZONTAL
        MENUITEM "表示を上下反転", IDM_VIEW_FLIP_VERTICAL
        MENUITEM "グリッド", IDM_VIEW_GRID
        MENUITEM "新しいビュー", IDM_VIEW_NEW
    END
    POPUP "レイヤー(&L)"
    BEGIN
        MENUITEM "複製", IDM_LAYER_DUPLICATE
        MENUITEM "削除", IDM_LAYER_DELETE
        MENUITEM "最前面へ移動", IDM_LAYER_MOVE_TOP
    END
    POPUP "選択(&S)"
    BEGIN
        MENUITEM "すべて選択", IDM_SELECTION_ALL
        MENUITEM "選択範囲を反転", IDM_SELECTION_INVERT
        MENUITEM "選択範囲を1px拡張", IDM_SELECTION_EXPAND
        MENUITEM "選択範囲を1px縮小", IDM_SELECTION_SHRINK
    END
    POPUP "フィルタ(&I)"
    BEGIN
        MENUITEM "直前のフィルタを再実行", IDM_FILTER_LAST
        MENUITEM SEPARATOR
        MENUITEM "シャープ（弱）", IDM_FILTER_SHARPEN_WEAK
        MENUITEM "シャープ（強）", IDM_FILTER_SHARPEN_STRONG
        MENUITEM "階調反転", IDM_FILTER_INVERT
        MENUITEM "ぼかし（弱）", IDM_FILTER_BLUR_WEAK
        MENUITEM "ぼかし（強）", IDM_FILTER_BLUR_STRONG
        MENUITEM "ガウスぼかし...", IDM_FILTER_GAUSSIAN
        MENUITEM "自動コントラスト", IDM_FILTER_AUTO_CONTRAST
        MENUITEM "明るさ・コントラスト...", IDM_FILTER_BRIGHTNESS
        MENUITEM "トーンカーブ...", IDM_FILTER_TONE_CURVE
        MENUITEM "レベル補正...", IDM_FILTER_LEVELS
        MENUITEM "色相・彩度・明度...", IDM_FILTER_HSV
        MENUITEM "カラーバランス...", IDM_FILTER_COLOR_BALANCE
        MENUITEM "アンシャープマスク...", IDM_FILTER_UNSHARP
        MENUITEM "ゴミ取り...", IDM_EFFECT_DUST
        MENUITEM SEPARATOR
        MENUITEM "調整レイヤーを作成...", IDM_ADJUSTMENT_CREATE
        MENUITEM "前の調整レイヤーを選択", IDM_ADJUSTMENT_PREVIOUS
        MENUITEM "次の調整レイヤーを選択", IDM_ADJUSTMENT_NEXT
        MENUITEM "調整レイヤーを再編集...", IDM_ADJUSTMENT_EDIT
        MENUITEM "調整レイヤーの表示切替", IDM_ADJUSTMENT_TOGGLE
        MENUITEM "調整レイヤーを最前面へ", IDM_ADJUSTMENT_MOVE_TOP
    END
    POPUP "ツール(&T)"
    BEGIN
        MENUITEM "鉛筆(&P)", IDM_TOOL_PENCIL
        MENUITEM "ブラシ(&B)", IDM_TOOL_BRUSH
        MENUITEM "消しゴム(&E)", IDM_TOOL_ERASER
        MENUITEM "フィル(&F)", IDM_TOOL_FILL
        MENUITEM "スポイト(&I)", IDM_TOOL_EYEDROPPER
        MENUITEM SEPARATOR
        MENUITEM "グラデーション...", IDM_EFFECT_GRADIENT
        MENUITEM "エアブラシ...", IDM_EFFECT_AIRBRUSH
        MENUITEM "境界色エアブラシ...", IDM_EFFECT_BOUNDARY_AIRBRUSH
        MENUITEM "ぼかしツール...", IDM_EFFECT_BLUR
        MENUITEM "スタンプ...", IDM_EFFECT_STAMP
        MENUITEM "ゴミ取り...", IDM_EFFECT_DUST
        MENUITEM "アルファグラデーション...", IDM_EFFECT_ALPHA_GRADIENT
        MENUITEM "アルファをグレースケール表示", IDM_EFFECT_ALPHA_VIEW
    END
    POPUP "プレーン(&P)"
    BEGIN
        MENUITEM "主線(&L)", IDM_PLANE_MAIN_LINE
        MENUITEM "彩色(&C)", IDM_PLANE_COLOR
    END
    POPUP "色(&C)"
    BEGIN
        MENUITEM "描画色...", IDM_COLOR_CHOOSE
        MENUITEM SEPARATOR
        MENUITEM "彩色チェックを解除", IDM_COLOR_CHECK_OFF
        MENUITEM "完全な白をチェック", IDM_COLOR_CHECK_LEGACY
        MENUITEM "白と透明をチェック", IDM_COLOR_CHECK_NATIVE
    END
    POPUP "ヘルプ(&H)"
    BEGIN
        MENUITEM "ショートカット編集...", IDM_SHORTCUT_EDIT
        MENUITEM "ショートカットを初期化", IDM_SHORTCUT_RESET
        MENUITEM SEPARATOR
        MENUITEM "Inkpodについて(&A)...", IDM_HELP_ABOUT
    END
END

IDD_M6_EDITOR DIALOGEX 0, 0, 314, 238
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "M6 エディター"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_M6_TITLE, 12, 10, 290, 18
    LTEXT           "P0", IDC_M6_PARAM0_LABEL, 12, 36, 76, 12
    EDITTEXT        IDC_M6_PARAM0, 94, 33, 72, 14, ES_AUTOHSCROLL
    LTEXT           "P1", IDC_M6_PARAM1_LABEL, 174, 36, 60, 12
    EDITTEXT        IDC_M6_PARAM1, 236, 33, 66, 14, ES_AUTOHSCROLL
    LTEXT           "P2", IDC_M6_PARAM2_LABEL, 12, 61, 76, 12
    EDITTEXT        IDC_M6_PARAM2, 94, 58, 72, 14, ES_AUTOHSCROLL
    LTEXT           "P3", IDC_M6_PARAM3_LABEL, 174, 61, 60, 12
    EDITTEXT        IDC_M6_PARAM3, 236, 58, 66, 14, ES_AUTOHSCROLL
    LTEXT           "P4", IDC_M6_PARAM4_LABEL, 12, 86, 76, 12
    EDITTEXT        IDC_M6_PARAM4, 94, 83, 72, 14, ES_AUTOHSCROLL
    COMBOBOX        IDC_M6_CHANNEL, 174, 83, 128, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_M6_MODE, 12, 110, 154, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_M6_POINTS, 174, 110, 128, 48, ES_AUTOHSCROLL | ES_MULTILINE | WS_VSCROLL
    AUTOCHECKBOX    "プレビューして確認", IDC_M6_OPTION1, 12, 145, 150, 14
    AUTOCHECKBOX    "45度制約 / 筆圧", IDC_M6_OPTION2, 12, 164, 150, 14
    LTEXT           "点/stop: input:output;... または position:RRGGBBAA;...", -1, 12, 184, 290, 18
    DEFPUSHBUTTON   "OK", IDOK, 166, 210, 64, 18
    PUSHBUTTON      "キャンセル", IDCANCEL, 238, 210, 64, 18
END

IDD_M6_PROGRESS DIALOGEX 0, 0, 250, 78
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "M6 処理中"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "準備中...", IDC_M6_PROGRESS_TEXT, 12, 12, 226, 12
    CONTROL         "", IDC_M6_PROGRESS_BAR, "msctls_progress32", WS_BORDER, 12, 30, 226, 12
    PUSHBUTTON      "キャンセル", IDCANCEL, 174, 53, 64, 18
END

IDD_ABOUT DIALOGEX 0, 0, 383, 290
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "About Inkpod"
FONT 9, "Segoe UI"
BEGIN
    CONTROL         "", IDC_ABOUT_ICON, "Static", SS_ICON | SS_CENTERIMAGE | SS_REALSIZECONTROL, 147, 36, 59, 47
    LTEXT           "Inkpod", IDC_ABOUT_NAME, 20, 103, 343, 24, SS_CENTER | SS_NOPREFIX
    LTEXT           "", IDC_ABOUT_DESCRIPTION, 32, 133, 319, 51, SS_CENTER | SS_NOPREFIX
    LTEXT           "", IDC_ABOUT_VERSION, 20, 187, 343, 15, SS_CENTER | SS_NOPREFIX
    LTEXT           "", IDC_ABOUT_COPYRIGHT, 20, 214, 343, 15, SS_CENTER | SS_NOPREFIX
    CONTROL         "", IDC_ABOUT_SEPARATOR, "Static", SS_ETCHEDHORZ, 0, 241, 383, 1
    DEFPUSHBUTTON   "OK", IDOK, 289, 253, 80, 26
END

IDD_SHORTCUT_EDITOR DIALOGEX 0, 0, 260, 112
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "ショートカット編集"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "コマンド", -1, 16, 17, 54, 12
    COMBOBOX        IDC_SHORTCUT_COMMAND, 76, 14, 168, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "キー", -1, 16, 48, 54, 12
    CONTROL         "", IDC_SHORTCUT_HOTKEY, "msctls_hotkey32", WS_BORDER | WS_TABSTOP, 76, 45, 168, 14
    DEFPUSHBUTTON   "OK", IDOK, 108, 82, 64, 18
    PUSHBUTTON      "キャンセル", IDCANCEL, 180, 82, 64, 18
END
