        MENUITEM "ブラシ(&B)", IDM_TOOL_BRUSH
        MENUITEM "消しゴム(&E)", IDM_TOOL_ERASER
        MENUITEM "フィル(&F)", IDM_TOOL_FILL
        MENUITEM "閉領域フィル", IDM_TOOL_CLOSED_FILL
        MENUITEM "塗りのばし", IDM_TOOL_FILL_EXTENSION
        MENUITEM "フィル設定...", IDM_TOOL_FILL_OPTIONS
        MENUITEM "スポイト(&I)", IDM_TOOL_EYEDROPPER
        POPUP "ベクター描画"
        BEGIN
