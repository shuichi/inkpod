    POPUP "制作(&W)"
    BEGIN
        POPUP "ライトテーブルセット"
        BEGIN
            MENUITEM "新規...", IDM_LT_SET_NEW
            MENUITEM "複製", IDM_LT_SET_DUPLICATE
            MENUITEM "削除", IDM_LT_SET_DELETE
