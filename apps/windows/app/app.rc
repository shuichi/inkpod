            MENUITEM "安全フレーム...", IDM_CELL_FRAME_SAFE
            MENUITEM "余白...", IDM_CELL_MARGINS
        END
    END
    POPUP "選択(&S)"
    BEGIN
        MENUITEM "すべて選択", IDM_SELECTION_ALL
        MENUITEM "選択解除", IDM_SELECTION_CLEAR
        POPUP "選択ツール"
        BEGIN
            MENUITEM "長方形", IDM_SELECTION_RECTANGLE
            MENUITEM "楕円", IDM_SELECTION_ELLIPSE
            MENUITEM "投げ縄", IDM_SELECTION_LASSO
            MENUITEM "折れ線", IDM_SELECTION_POLYLINE
            MENUITEM "トレース", IDM_SELECTION_TRACE
            MENUITEM "色の杖", IDM_SELECTION_WAND
        END
        POPUP "作成モード"
        BEGIN
            MENUITEM "新規", IDM_SELECTION_MODE_NEW
            MENUITEM "追加", IDM_SELECTION_MODE_ADD
            MENUITEM "削除", IDM_SELECTION_MODE_SUBTRACT
            MENUITEM "交差", IDM_SELECTION_MODE_INTERSECT
        END
        MENUITEM "描画色を選択", IDM_SELECTION_COLOR
        MENUITEM "描画色以外を選択", IDM_SELECTION_COLOR_DIFFERENT
        MENUITEM "描画色を選択範囲に追加", IDM_SELECTION_COLOR_ADD
        MENUITEM "選択範囲を反転", IDM_SELECTION_INVERT
        MENUITEM "選択範囲を拡張...", IDM_SELECTION_EXPAND
        MENUITEM "選択範囲を縮小...", IDM_SELECTION_SHRINK
        POPUP "変換"
        BEGIN
            MENUITEM "選択範囲をレイヤーへ", IDM_SELECTION_TO_LAYER
            MENUITEM "レイヤーを選択範囲へ", IDM_SELECTION_FROM_LAYER
            MENUITEM "レイヤーを追加", IDM_SELECTION_LAYER_ADD
            MENUITEM "レイヤーを削除", IDM_SELECTION_LAYER_SUBTRACT
        END
    END
    POPUP "フィルタ(&I)"
    BEGIN
        MENUITEM "直前のフィルタを再実行", IDM_FILTER_LAST
        MENUITEM SEPARATOR
        MENUITEM "シャープ（弱）", IDM_FILTER_SHARPEN_WEAK
        MENUITEM "シャープ（強）", IDM_FILTER_SHARPEN_STRONG
        MENUITEM "階調反転", IDM_FILTER_INVERT
        MENUITEM "ぼかし（弱）", IDM_FILTER_BLUR_WEAK
        MENUITEM "ぼかし（強）", IDM_FILTER_BLUR_STRONG
        MENUITEM "ガウスぼかし...", IDM_FILTER_GAUSSIAN
        MENUITEM "自動コントラスト", IDM_FILTER_AUTO_CONTRAST
        MENUITEM "明るさ・コントラスト...", IDM_FILTER_BRIGHTNESS
        MENUITEM "トーンカーブ...", IDM_FILTER_TONE_CURVE
        MENUITEM "レベル補正...", IDM_FILTER_LEVELS
        MENUITEM "色相・彩度・明度...", IDM_FILTER_HSV
        MENUITEM "カラーバランス...", IDM_FILTER_COLOR_BALANCE
        MENUITEM "アンシャープマスク...", IDM_FILTER_UNSHARP
        MENUITEM "ゴミ取り...", IDM_EFFECT_DUST
        MENUITEM SEPARATOR
        MENUITEM "調整レイヤーを作成...", IDM_ADJUSTMENT_CREATE
        MENUITEM "前の調整レイヤーを選択", IDM_ADJUSTMENT_PREVIOUS
        MENUITEM "次の調整レイヤーを選択", IDM_ADJUSTMENT_NEXT
