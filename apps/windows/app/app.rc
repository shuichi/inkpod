        MENUITEM "彩色(&C)", IDM_PLANE_COLOR
        MENUITEM SEPARATOR
        MENUITEM "新規...", IDM_PLANE_NEW
        MENUITEM "複製", IDM_PLANE_DUPLICATE
        MENUITEM "削除", IDM_PLANE_DELETE
        MENUITEM "上へ", IDM_PLANE_MOVE_UP
        MENUITEM "下へ", IDM_PLANE_MOVE_DOWN
        MENUITEM "表示切替", IDM_PLANE_TOGGLE_VISIBLE
        MENUITEM "編集可否切替", IDM_PLANE_TOGGLE_EDITABLE
        MENUITEM "不透明度...", IDM_PLANE_OPACITY
        MENUITEM "変換...", IDM_PLANE_CONVERT
