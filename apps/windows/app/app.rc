            MENUITEM "次のページ", IDM_CHART_NEXT_PAGE
            MENUITEM "保存...", IDM_CHART_SAVE
            MENUITEM "読み込み...", IDM_CHART_LOAD
            MENUITEM "カット", IDM_CHART_CUT
            MENUITEM "コピー", IDM_CHART_COPY
            MENUITEM "ペースト", IDM_CHART_PASTE
