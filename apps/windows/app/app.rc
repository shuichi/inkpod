        MENUITEM "同種を統合", IDM_LAYER_MERGE
        MENUITEM "プロパティ...", IDM_LAYER_PROPERTIES
    END
    POPUP "セル(&D)"
    BEGIN
        MENUITEM "用紙設定...", IDM_CELL_PAPER_SETTINGS
        MENUITEM "撮影フレームを考慮して用紙サイズ変更", IDM_CELL_FIT_CAPTURE_FRAME
        MENUITEM "画像サイズ...", IDM_CELL_IMAGE_SIZE
        MENUITEM "画像解像度...", IDM_CELL_RESOLUTION
        POPUP "鏡像"
        BEGIN
            MENUITEM "水平方向", IDM_EDIT_MIRROR_HORIZONTAL
            MENUITEM "垂直方向", IDM_CELL_MIRROR_VERTICAL
        END
        POPUP "回転"
        BEGIN
            MENUITEM "左90度", IDM_CELL_ROTATE_LEFT
            MENUITEM "右90度", IDM_CELL_ROTATE_RIGHT
        END
        POPUP "フレーム設定"
        BEGIN
