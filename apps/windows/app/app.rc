            END
            MENUITEM "停止", IDM_MOTION_STOP
        END
    END
    POPUP "ヘルプ(&H)"
    BEGIN
        MENUITEM "ショートカット編集...", IDM_SHORTCUT_EDIT
        MENUITEM "ショートカットを初期化", IDM_SHORTCUT_RESET
        MENUITEM SEPARATOR
        MENUITEM "Inkpodについて(&A)...", IDM_HELP_ABOUT
    END
END

IDD_VIEW_OPTIONS DIALOGEX 0, 0, 236, 142
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "表示設定"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "値", IDC_VIEW_VALUE_LABEL, 12, 15, 74, 12
    EDITTEXT        IDC_VIEW_VALUE, 92, 12, 128, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "値2", IDC_VIEW_VALUE2_LABEL, 12, 39, 74, 12
    EDITTEXT        IDC_VIEW_VALUE2, 92, 36, 128, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "値3", IDC_VIEW_VALUE3_LABEL, 12, 63, 74, 12
    EDITTEXT        IDC_VIEW_VALUE3, 92, 60, 128, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "値4", IDC_VIEW_VALUE4_LABEL, 12, 87, 74, 12
    EDITTEXT        IDC_VIEW_VALUE4, 92, 84, 128, 14, ES_AUTOHSCROLL | ES_NUMBER
    DEFPUSHBUTTON   "OK", IDOK, 84, 112, 64, 18
    PUSHBUTTON      "キャンセル", IDCANCEL, 156, 112, 64, 18
END

IDD_TEXT_INPUT DIALOGEX 0, 0, 236, 78
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "入力"
FONT 9, "Segoe UI"
BEGIN
