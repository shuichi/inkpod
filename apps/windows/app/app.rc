#include <windows.h>
#include "app_version.h"
#include "resource.h"

#pragma code_page(65001)

1 RT_MANIFEST "app.manifest"
IDI_APP_ICON ICON "../package/Assets/app.ico"
IDR_ABOUT_ICON_88_PNG RCDATA "../package/Assets/AppList.scale-200.png"
IDR_ABOUT_ICON_256_PNG RCDATA "../package/Assets/AppList.targetsize-256.png"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION INKPOD_VERSION_RESOURCE
 PRODUCTVERSION INKPOD_VERSION_RESOURCE
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041104b0"
        BEGIN
            VALUE "CompanyName", "inkpod contributors\0"
            VALUE "FileDescription", "アニメーション彩色のための制作アプリ\0"
            VALUE "FileVersion", INKPOD_VERSION_STRING "\0"
            VALUE "InternalName", "inkpod\0"
            VALUE "OriginalFilename", "inkpod.exe\0"
            VALUE "ProductName", "inkpod\0"
            VALUE "ProductVersion", INKPOD_VERSION_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0411, 1200
    END
END

STRINGTABLE
BEGIN
    IDS_APP_TITLE "inkpod"
    IDS_MAIN_WINDOW_CLASS "InkpodMainWindow"
    IDS_APP_VERSION INKPOD_VERSION_STRING
    IDS_ABOUT_DESCRIPTION "Inkpod is a GPU-accelerated painting engine with vector-based strokes for non-destructive editing."
    IDS_ABOUT_COPYRIGHT "© Shuichi Kurabayashi"
END

IDR_MAIN_MENU MENU
BEGIN
    POPUP "ファイル(&F)"
    BEGIN
        MENUITEM "新規セル(&N)\tCtrl+N", IDM_FILE_NEW
        MENUITEM "開く(&O)...\tCtrl+O", IDM_FILE_OPEN
        MENUITEM "保存(&S)\tCtrl+S", IDM_FILE_SAVE
        MENUITEM "名前を付けて保存(&A)...", IDM_FILE_SAVE_AS
        MENUITEM "復帰(&R)", IDM_FILE_REVERT
        MENUITEM "レイヤーを部分的に復帰", IDM_FILE_REVERT_PARTIAL
        MENUITEM "ラスタ－を読み込み...", IDM_FILE_IMPORT_RASTER
        MENUITEM "ラスタ－を書き出し...", IDM_FILE_EXPORT_RASTER
        MENUITEM "Recoveryを保存(&V)", IDM_FILE_AUTOSAVE_NOW
        MENUITEM "Recoveryを開く(&Y)...", IDM_FILE_OPEN_RECOVERY
        MENUITEM SEPARATOR
        MENUITEM "終了(&X)", IDM_APP_EXIT
    END
    POPUP "編集(&E)"
    BEGIN
        MENUITEM "元に戻す(&U)\tCtrl+Z", IDM_EDIT_UNDO
        MENUITEM "やり直し(&R)\tCtrl+Y", IDM_EDIT_REDO
        MENUITEM "複数段階戻る...", IDM_EDIT_HISTORY_BACK
        MENUITEM "複数段階進む...", IDM_EDIT_HISTORY_FORWARD
        MENUITEM SEPARATOR
        MENUITEM "カット(&X)\tCtrl+X", IDM_EDIT_CUT
        MENUITEM "コピー(&C)\tCtrl+C", IDM_EDIT_COPY
        MENUITEM "貼り付け(&P)\tCtrl+V", IDM_EDIT_PASTE
        MENUITEM "選択プレーンにペースト", IDM_EDIT_PASTE_SELECTED
        MENUITEM "変換してペースト...", IDM_EDIT_PASTE_CONVERTED
        POPUP "フローティング選択"
        BEGIN
            MENUITEM "移動・拡大縮小・回転...", IDM_EDIT_FLOATING_TRANSFORM
            MENUITEM "確定", IDM_EDIT_FLOATING_COMMIT
            MENUITEM "キャンセル", IDM_EDIT_FLOATING_CANCEL
        END
    END
    POPUP "表示(&V)"
    BEGIN
        MENUITEM "拡大(&I)", IDM_VIEW_ZOOM_IN
        MENUITEM "縮小(&O)", IDM_VIEW_ZOOM_OUT
        MENUITEM "全体表示(&F)", IDM_VIEW_FIT
        MENUITEM "ピクセル等倍(&1)", IDM_VIEW_ONE_TO_ONE
        MENUITEM "表示倍率...", IDM_VIEW_ZOOM_PERCENT
        MENUITEM "範囲を拡大", IDM_VIEW_BOX_ZOOM
        MENUITEM SEPARATOR
        MENUITEM "表示を左右反転", IDM_VIEW_FLIP_HORIZONTAL
        MENUITEM "表示を上下反転", IDM_VIEW_FLIP_VERTICAL
        MENUITEM "ルーラー", IDM_VIEW_RULER
        MENUITEM "ガイド線", IDM_VIEW_GUIDES
        MENUITEM "グリッド", IDM_VIEW_GRID
        POPUP "スナップ"
        BEGIN
            MENUITEM "ガイド", IDM_VIEW_SNAP_GUIDES
            MENUITEM "グリッド", IDM_VIEW_SNAP_GRID
        END
        POPUP "ガイド"
        BEGIN
            MENUITEM "垂直ガイドを追加...", IDM_VIEW_GUIDE_VERTICAL
            MENUITEM "水平ガイドを追加...", IDM_VIEW_GUIDE_HORIZONTAL
            MENUITEM "ガイドを移動", IDM_VIEW_GUIDE_MOVE
            MENUITEM "すべて削除", IDM_VIEW_GUIDE_DELETE_ALL
        END
        MENUITEM "グリッド設定...", IDM_VIEW_GRID_SETTINGS
        MENUITEM "透明部分", IDM_VIEW_TRANSPARENT
        MENUITEM "新しいビュー", IDM_VIEW_NEW
    END
    POPUP "レイヤー(&L)"
    BEGIN
        MENUITEM "新規...", IDM_LAYER_NEW
        MENUITEM "複製", IDM_LAYER_DUPLICATE
        MENUITEM "削除", IDM_LAYER_DELETE
        MENUITEM "非表示を削除", IDM_LAYER_DELETE_HIDDEN
        MENUITEM "最前面へ移動", IDM_LAYER_MOVE_TOP
        MENUITEM "上へ", IDM_LAYER_MOVE_UP
        MENUITEM "下へ", IDM_LAYER_MOVE_DOWN
        MENUITEM "表示切替", IDM_LAYER_TOGGLE_VISIBLE
        MENUITEM "編集可否切替", IDM_LAYER_TOGGLE_EDITABLE
