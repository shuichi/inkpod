        MENUITEM "Light Table", IDM_WINDOW_LIGHT_TABLE
        MENUITEM "Subpalette / Reference View", IDM_WINDOW_SUBPALETTE
        MENUITEM "Batch", IDM_WINDOW_BATCH
        MENUITEM "Job Progress", IDM_WINDOW_JOB_PROGRESS
        MENUITEM SEPARATOR
        POPUP "Workspace"
        BEGIN
            POPUP "Preset"
            BEGIN
                MENUITEM "Coloring", IDM_WORKSPACE_PRESET_COLORING
                MENUITEM "Line Cleanup", IDM_WORKSPACE_PRESET_LINE_CLEANUP
                MENUITEM "Reference / Check", IDM_WORKSPACE_PRESET_REFERENCE
                MENUITEM "Batch", IDM_WORKSPACE_PRESET_BATCH
                MENUITEM "Focus", IDM_WORKSPACE_PRESET_FOCUS
            END
            MENUITEM SEPARATOR
            MENUITEM "Save Workspace", IDM_WORKSPACE_SAVE
            MENUITEM "Save As...", IDM_WORKSPACE_SAVE_AS
            MENUITEM "Restore Saved Workspace", IDM_WORKSPACE_RESTORE
            MENUITEM "Reset to Default", IDM_WORKSPACE_RESET
            POPUP "Auto-hide Auxiliary Panes"
            BEGIN
                MENUITEM "Locator", IDM_WORKSPACE_AUTOHIDE_LOCATOR
                MENUITEM "Sequence / Preview", IDM_WORKSPACE_AUTOHIDE_SEQUENCE
                MENUITEM "Light Table", IDM_WORKSPACE_AUTOHIDE_LIGHT_TABLE
                MENUITEM "Subpalette / Reference", IDM_WORKSPACE_AUTOHIDE_REFERENCE
                MENUITEM "Batch", IDM_WORKSPACE_AUTOHIDE_BATCH
            END
            MENUITEM "Mirror Horizontally", IDM_WORKSPACE_MIRROR
        END
    END
    POPUP "\u0026Help"
    BEGIN
        MENUITEM "inkpod \u0026Help\tF1", IDM_HELP_MANUAL
        MENUITEM "Inkpod \u0026File Format", IDM_HELP_FILE_FORMAT
        MENUITEM "A\u0026cknowledgements", IDM_HELP_ACKNOWLEDGEMENTS
        MENUITEM "Inkpod \u0026Website", IDM_HELP_WEB_PAGE
        MENUITEM SEPARATOR
        MENUITEM "\u0026About Inkpod...", IDM_HELP_ABOUT
    END
END

