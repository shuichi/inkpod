IDD_FILL_OPTIONS DIALOGEX 0, 0, 330, 220
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "Fill Settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Operation", -1, 12, 14, 70, 12
    COMBOBOX        IDC_FILL_OPERATION, 88, 11, 226, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
