    LTEXT           "Gap", -1, 184, 40, 44, 12
    EDITTEXT        IDC_FILL_GAP, 232, 37, 82, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Extension distance", -1, 12, 64, 70, 12
    EDITTEXT        IDC_FILL_EXTENSION, 88, 61, 82, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Inclusive fill", -1, 184, 64, 44, 12
    COMBOBOX        IDC_FILL_INCLUSION_MODE, 232, 61, 82, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Target colors (RRGGBBAA; up to 6)", -1, 12, 89, 150, 12
    EDITTEXT        IDC_FILL_COLORS, 12, 103, 302, 34, ES_AUTOHSCROLL | ES_MULTILINE | WS_VSCROLL
    AUTOCHECKBOX    "Abort fill overflow", IDC_FILL_OVERFLOW, 12, 144, 106, 14
    AUTOCHECKBOX    "Detached same-color regions", IDC_FILL_DETACHED, 124, 144, 94, 14
    AUTOCHECKBOX    "Transparent only", IDC_FILL_TRANSPARENT, 224, 144, 90, 14
    AUTOCHECKBOX    "Limit to document selection", IDC_FILL_SELECTION, 12, 163, 130, 14
    AUTOCHECKBOX    "Use LT as boundary", IDC_FILL_LIGHT_BOUNDARY, 148, 163, 78, 14
    AUTOCHECKBOX    "Use LT colors", IDC_FILL_LIGHT_COLOR, 232, 163, 82, 14
    DEFPUSHBUTTON   "OK", IDOK, 178, 192, 64, 18
    PUSHBUTTON      "Cancel", IDCANCEL, 250, 192, 64, 18
END
