            MENUITEM "一時停止/再開", IDM_MOTION_PAUSE
            MENUITEM "前のフレーム", IDM_MOTION_PREVIOUS
            MENUITEM "次のフレーム", IDM_MOTION_NEXT
            MENUITEM "先頭フレーム", IDM_MOTION_FIRST
            MENUITEM "末尾フレーム", IDM_MOTION_LAST
            POPUP "FPS"
            BEGIN
                MENUITEM "30 FPS", IDM_MOTION_FPS_30
                MENUITEM "25 FPS", IDM_MOTION_FPS_25
                MENUITEM "24 FPS", IDM_MOTION_FPS_24
                MENUITEM "12 FPS", IDM_MOTION_FPS_12
                MENUITEM "10 FPS", IDM_MOTION_FPS_10
                MENUITEM "8 FPS", IDM_MOTION_FPS_8
            END
            MENUITEM "停止", IDM_MOTION_STOP
        END
        POPUP "バッチ"
        BEGIN
            MENUITEM "入力ファイル...", IDM_BATCH_INPUT_FILE
            MENUITEM "入力フォルダー...", IDM_BATCH_INPUT_FOLDER
            MENUITEM "現在の連番", IDM_BATCH_INPUT_CURRENT
            MENUITEM "セル番号範囲...", IDM_BATCH_INPUT_RANGE
            MENUITEM SEPARATOR
            POPUP "項目を追加"
            BEGIN
                MENUITEM "色置換", IDM_BATCH_ADD_COLOR_REPLACE
                MENUITEM "彩色プレーンへ送る", IDM_BATCH_ADD_MOVE_TO_COLOR_PLANE
                MENUITEM "マスキング", IDM_BATCH_ADD_MASKING
                MENUITEM "消去", IDM_BATCH_ADD_ERASE
            END
            MENUITEM "複製", IDM_BATCH_OPERATION_DUPLICATE
            MENUITEM "色置換 old/new を入替", IDM_BATCH_REPLACE_SWAP
            MENUITEM "二セル比較から色置換行を抽出...", IDM_BATCH_EXTRACT_PAIRS
            MENUITEM "選択項目を削除", IDM_BATCH_OPERATION_REMOVE
            MENUITEM "上へ", IDM_BATCH_OPERATION_UP
            MENUITEM "下へ", IDM_BATCH_OPERATION_DOWN
            MENUITEM SEPARATOR
            POPUP "出力"
            BEGIN
                MENUITEM "フォルダー", IDM_BATCH_OUTPUT_FOLDER
                MENUITEM "発行時のアクティブ文書", IDM_BATCH_OUTPUT_ACTIVE_DOCUMENT
                MENUITEM "新規タブとして追加", IDM_BATCH_OUTPUT_NEW_TABS
                MENUITEM "フォルダー・命名・待機...", IDM_BATCH_OUTPUT_SETTINGS
            END
            POPUP "失敗時"
            BEGIN
                MENUITEM "記録して続行", IDM_BATCH_FAILURE_CONTINUE
                MENUITEM "記録して停止", IDM_BATCH_FAILURE_STOP
            END
            MENUITEM "プレビュー", IDM_BATCH_PREVIEW
            MENUITEM "全実行", IDM_BATCH_RUN_ALL
            MENUITEM "キャンセル", IDM_BATCH_CANCEL
            MENUITEM SEPARATOR
            MENUITEM "セットを保存...", IDM_BATCH_SAVE_SET
            MENUITEM "セットを読み込み...", IDM_BATCH_LOAD_SET
        END
    END
    POPUP "ウィンドウ(&N)"
    BEGIN
        MENUITEM "新しいビュー", IDM_VIEW_NEW
        MENUITEM "ビューを閉じる", IDM_VIEW_CLOSE
        MENUITEM "文書を閉じる", IDM_DOCUMENT_CLOSE
        MENUITEM "次のタブ", IDM_TAB_NEXT
        MENUITEM "前のタブ", IDM_TAB_PREVIOUS
        MENUITEM "タブを左へ移動", IDM_TAB_MOVE_LEFT
        MENUITEM "タブを右へ移動", IDM_TAB_MOVE_RIGHT
        MENUITEM SEPARATOR
        MENUITEM "右へ分割", IDM_EDITOR_SPLIT_RIGHT
        MENUITEM "下へ分割", IDM_EDITOR_SPLIT_DOWN
        MENUITEM "別グループへ移動", IDM_EDITOR_MOVE_OTHER_GROUP
        MENUITEM "別グループに新しいビュー", IDM_EDITOR_NEW_VIEW_OTHER_GROUP
        MENUITEM "次のエディターグループ", IDM_EDITOR_GROUP_NEXT
        MENUITEM "グループを閉じる", IDM_EDITOR_GROUP_CLOSE
        MENUITEM SEPARATOR
        MENUITEM "新しいウィンドウ", IDM_WORKSPACE_NEW_WINDOW
        MENUITEM "ビューを次のウィンドウへ移動", IDM_VIEW_MOVE_NEXT_WINDOW
        MENUITEM "次のウィンドウに複製ビュー", IDM_VIEW_DUPLICATE_NEXT_WINDOW
        MENUITEM "ビューを新しいウィンドウへ移動", IDM_VIEW_MOVE_NEW_WINDOW
        MENUITEM "新しいウィンドウに複製ビュー", IDM_VIEW_DUPLICATE_NEW_WINDOW
        MENUITEM SEPARATOR
        MENUITEM "ツールパレット", IDM_WINDOW_TOOL_PALETTE
        MENUITEM "ツールオプション", IDM_WINDOW_TOOL_OPTIONS
        MENUITEM "カラー", IDM_WINDOW_COLOR_PANE
        MENUITEM "レイヤー／プレーン", IDM_WINDOW_LAYER_PALETTE
        MENUITEM "ロケーター", IDM_WINDOW_LOCATOR
        MENUITEM "シーケンス", IDM_WINDOW_SEQUENCE
        MENUITEM "ライトテーブル", IDM_WINDOW_LIGHT_TABLE
        MENUITEM "サブパレット／参照ビュー", IDM_WINDOW_SUBPALETTE
        MENUITEM "バッチ", IDM_WINDOW_BATCH
        MENUITEM "処理進捗", IDM_WINDOW_JOB_PROGRESS
        MENUITEM SEPARATOR
        POPUP "ワークスペース"
        BEGIN
            POPUP "プリセット"
            BEGIN
                MENUITEM "彩色", IDM_WORKSPACE_PRESET_COLORING
                MENUITEM "線整理", IDM_WORKSPACE_PRESET_LINE_CLEANUP
                MENUITEM "参照・チェック", IDM_WORKSPACE_PRESET_REFERENCE
                MENUITEM "バッチ", IDM_WORKSPACE_PRESET_BATCH
                MENUITEM "集中", IDM_WORKSPACE_PRESET_FOCUS
            END
            MENUITEM SEPARATOR
            MENUITEM "ワークスペースを保存", IDM_WORKSPACE_SAVE
            MENUITEM "名前を付けて保存...", IDM_WORKSPACE_SAVE_AS
            MENUITEM "保存したワークスペースを復元", IDM_WORKSPACE_RESTORE
            MENUITEM "既定に戻す", IDM_WORKSPACE_RESET
            POPUP "補助ペインを自動格納"
            BEGIN
                MENUITEM "ロケーター", IDM_WORKSPACE_AUTOHIDE_LOCATOR
                MENUITEM "シーケンス／プレビュー", IDM_WORKSPACE_AUTOHIDE_SEQUENCE
                MENUITEM "ライトテーブル", IDM_WORKSPACE_AUTOHIDE_LIGHT_TABLE
                MENUITEM "サブパレット／参照", IDM_WORKSPACE_AUTOHIDE_REFERENCE
                MENUITEM "バッチ", IDM_WORKSPACE_AUTOHIDE_BATCH
            END
            MENUITEM "左右を反転", IDM_WORKSPACE_MIRROR
        END
    END
    POPUP "ヘルプ(&H)"
    BEGIN
        MENUITEM "inkpod ヘルプ(&H)\tF1", IDM_HELP_MANUAL
        MENUITEM "Inkpodファイルフォーマット(&F)", IDM_HELP_FILE_FORMAT
        MENUITEM "謝辞(&C)", IDM_HELP_ACKNOWLEDGEMENTS
        MENUITEM "Inkpodウェブページ(&W)", IDM_HELP_WEB_PAGE
        MENUITEM SEPARATOR
        MENUITEM "Inkpodについて(&A)...", IDM_HELP_ABOUT
    END
END

