            MENUITEM "前のセル(&P)", IDM_SEQ_PREVIOUS
            MENUITEM "次のセル(&N)", IDM_SEQ_NEXT
            MENUITEM "セル番号で移動(&G)...", IDM_SEQ_GOTO
            MENUITEM "端点で循環(&W)", IDM_SEQ_WRAP_ENDPOINTS
            MENUITEM "選択セルをサブパレット登録(&R)", IDM_SUBPALETTE_SET
            MENUITEM "サブパレット色サンプル(&S)...", IDM_SUBPALETTE_SAMPLE
        END
        POPUP "モーションチェック(&M)"
        BEGIN
            MENUITEM "開始・設定(&S)...", IDM_MOTION_START
            MENUITEM "一時停止/再開(&P)", IDM_MOTION_PAUSE
            MENUITEM "前のフレーム(&R)", IDM_MOTION_PREVIOUS
            MENUITEM "次のフレーム(&N)", IDM_MOTION_NEXT
            MENUITEM "先頭フレーム(&F)", IDM_MOTION_FIRST
            MENUITEM "末尾フレーム(&L)", IDM_MOTION_LAST
            POPUP "フレームレート (FPS)(&T)"
            BEGIN
                MENUITEM "30 FPS(&3)", IDM_MOTION_FPS_30
                MENUITEM "25 FPS(&5)", IDM_MOTION_FPS_25
                MENUITEM "24 FPS(&4)", IDM_MOTION_FPS_24
                MENUITEM "12 FPS(&1)", IDM_MOTION_FPS_12
                MENUITEM "10 FPS(&0)", IDM_MOTION_FPS_10
                MENUITEM "8 FPS(&8)", IDM_MOTION_FPS_8
            END
            MENUITEM "停止(&O)", IDM_MOTION_STOP
        END
        POPUP "バッチ(&B)"
        BEGIN
            MENUITEM "入力ファイル(&I)...", IDM_BATCH_INPUT_FILE
            MENUITEM "入力フォルダー(&F)...", IDM_BATCH_INPUT_FOLDER
            MENUITEM "現在の連番(&Q)", IDM_BATCH_INPUT_CURRENT
            MENUITEM "セル番号範囲(&N)...", IDM_BATCH_INPUT_RANGE
            MENUITEM SEPARATOR
            POPUP "項目を追加(&A)"
            BEGIN
                MENUITEM "色置換(&C)", IDM_BATCH_ADD_COLOR_REPLACE
                MENUITEM "彩色プレーンへ送る(&M)", IDM_BATCH_ADD_MOVE_TO_COLOR_PLANE
                MENUITEM "マスキング(&A)", IDM_BATCH_ADD_MASKING
                MENUITEM "消去(&E)", IDM_BATCH_ADD_ERASE
            END
            MENUITEM "複製(&U)", IDM_BATCH_OPERATION_DUPLICATE
            MENUITEM "色置換 old/new を入替(&S)", IDM_BATCH_REPLACE_SWAP
            MENUITEM "二セル比較から色置換行を抽出(&E)...", IDM_BATCH_EXTRACT_PAIRS
            MENUITEM "選択項目を削除(&D)", IDM_BATCH_OPERATION_REMOVE
            MENUITEM "上へ(&P)", IDM_BATCH_OPERATION_UP
            MENUITEM "下へ(&W)", IDM_BATCH_OPERATION_DOWN
            MENUITEM SEPARATOR
            POPUP "出力(&O)"
            BEGIN
                MENUITEM "フォルダー(&F)", IDM_BATCH_OUTPUT_FOLDER
                MENUITEM "発行時のアクティブ文書(&D)", IDM_BATCH_OUTPUT_ACTIVE_DOCUMENT
                MENUITEM "新規タブとして追加(&T)", IDM_BATCH_OUTPUT_NEW_TABS
                MENUITEM "フォルダー・命名・待機(&N)...", IDM_BATCH_OUTPUT_SETTINGS
            END
            POPUP "失敗時(&H)"
            BEGIN
                MENUITEM "記録して続行(&C)", IDM_BATCH_FAILURE_CONTINUE
                MENUITEM "記録して停止(&S)", IDM_BATCH_FAILURE_STOP
            END
            MENUITEM "プレビュー(&V)", IDM_BATCH_PREVIEW
            MENUITEM "全実行(&R)", IDM_BATCH_RUN_ALL
            MENUITEM "キャンセル(&C)", IDM_BATCH_CANCEL
            MENUITEM SEPARATOR
            MENUITEM "セットを保存(&T)...", IDM_BATCH_SAVE_SET
            MENUITEM "セットを読み込み(&L)...", IDM_BATCH_LOAD_SET
        END
    END
    POPUP "ウィンドウ(&W)"
    BEGIN
        MENUITEM "ツールパレット(&E)", IDM_WINDOW_TOOL_PALETTE
        MENUITEM "ツールオプション(&O)", IDM_WINDOW_TOOL_OPTIONS
        MENUITEM "カラー(&C)", IDM_WINDOW_COLOR_PANE
        MENUITEM "レイヤー／プレーン(&L)", IDM_WINDOW_LAYER_PALETTE
        MENUITEM "ロケーター(&R)", IDM_WINDOW_LOCATOR
        MENUITEM "シーケンス(&S)", IDM_WINDOW_SEQUENCE
        MENUITEM "ライトテーブル(&T)", IDM_WINDOW_LIGHT_TABLE
        MENUITEM "サブパレット／参照ビュー(&P)", IDM_WINDOW_SUBPALETTE
        MENUITEM "バッチ(&B)", IDM_WINDOW_BATCH
        MENUITEM SEPARATOR
        POPUP "ビューとタブ(&V)"
        BEGIN
            MENUITEM "新しいビュー(&N)", IDM_VIEW_NEW
            MENUITEM "ビューを閉じる(&V)", IDM_VIEW_CLOSE
            MENUITEM "文書を閉じる(&D)", IDM_DOCUMENT_CLOSE
            MENUITEM "次のタブ(&T)", IDM_TAB_NEXT
            MENUITEM "前のタブ(&P)", IDM_TAB_PREVIOUS
            MENUITEM "タブを左へ移動(&L)", IDM_TAB_MOVE_LEFT
            MENUITEM "タブを右へ移動(&R)", IDM_TAB_MOVE_RIGHT
        END
        POPUP "エディターグループ(&G)"
        BEGIN
            MENUITEM "右へ分割(&R)", IDM_EDITOR_SPLIT_RIGHT
            MENUITEM "下へ分割(&D)", IDM_EDITOR_SPLIT_DOWN
            MENUITEM "別グループへ移動(&M)", IDM_EDITOR_MOVE_OTHER_GROUP
            MENUITEM "別グループに新しいビュー(&N)", IDM_EDITOR_NEW_VIEW_OTHER_GROUP
            MENUITEM "次のエディターグループ(&E)", IDM_EDITOR_GROUP_NEXT
            MENUITEM "グループ 1 にフォーカス(&1)", IDM_EDITOR_GROUP_FIRST
            MENUITEM "グループ 2 にフォーカス(&2)", IDM_EDITOR_GROUP_SECOND
            MENUITEM "グループを閉じる(&C)", IDM_EDITOR_GROUP_CLOSE
        END
        POPUP "ウィンドウ(&W)"
        BEGIN
            MENUITEM "新しいウィンドウ(&N)", IDM_WORKSPACE_NEW_WINDOW
            MENUITEM "ビューを次のウィンドウへ移動(&W)", IDM_VIEW_MOVE_NEXT_WINDOW
            MENUITEM "次のウィンドウに複製ビュー(&D)", IDM_VIEW_DUPLICATE_NEXT_WINDOW
            MENUITEM "ビューを新しいウィンドウへ移動(&V)", IDM_VIEW_MOVE_NEW_WINDOW
            MENUITEM "新しいウィンドウに複製ビュー(&U)", IDM_VIEW_DUPLICATE_NEW_WINDOW
        END
        POPUP "ワークスペース(&A)"
        BEGIN
            POPUP "プリセット(&P)"
            BEGIN
                MENUITEM "彩色(&C)", IDM_WORKSPACE_PRESET_COLORING
                MENUITEM "線整理(&L)", IDM_WORKSPACE_PRESET_LINE_CLEANUP
                MENUITEM "参照・チェック(&R)", IDM_WORKSPACE_PRESET_REFERENCE
                MENUITEM "バッチ(&B)", IDM_WORKSPACE_PRESET_BATCH
                MENUITEM "集中(&F)", IDM_WORKSPACE_PRESET_FOCUS
            END
            MENUITEM SEPARATOR
            MENUITEM "ワークスペースを保存(&S)", IDM_WORKSPACE_SAVE
            MENUITEM "名前を付けて保存(&A)...", IDM_WORKSPACE_SAVE_AS
            MENUITEM "保存したワークスペースを復元(&R)", IDM_WORKSPACE_RESTORE
            MENUITEM "既定に戻す(&D)", IDM_WORKSPACE_RESET
            POPUP "補助ペインを自動格納(&H)"
            BEGIN
                MENUITEM "ロケーター(&R)", IDM_WORKSPACE_AUTOHIDE_LOCATOR
                MENUITEM "シーケンス／プレビュー(&S)", IDM_WORKSPACE_AUTOHIDE_SEQUENCE
                MENUITEM "ライトテーブル(&T)", IDM_WORKSPACE_AUTOHIDE_LIGHT_TABLE
                MENUITEM "サブパレット／参照(&P)", IDM_WORKSPACE_AUTOHIDE_REFERENCE
                MENUITEM "バッチ(&B)", IDM_WORKSPACE_AUTOHIDE_BATCH
            END
            MENUITEM "左右を反転(&M)", IDM_WORKSPACE_MIRROR
        END
    END
    POPUP "ヘルプ(&H)"
    BEGIN
        MENUITEM "inkpod ヘルプ(&H)\tF1", IDM_HELP_MANUAL
        MENUITEM "Inkpodファイルフォーマット(&F)", IDM_HELP_FILE_FORMAT
        MENUITEM "謝辞(&C)", IDM_HELP_ACKNOWLEDGEMENTS
        MENUITEM "Inkpodウェブページ(&W)", IDM_HELP_WEB_PAGE
        MENUITEM "設定ファイルを開く(&S)", IDM_HELP_OPEN_SETTINGS_FILE
        MENUITEM SEPARATOR
        MENUITEM "Inkpodについて(&A)...", IDM_HELP_ABOUT
    END
END

