    "help.acknowledgements.body" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Inkpod uses Rust and Apple system frameworks. Third-party licenses are documented with the source distribution." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "InkpodはRustとAppleのシステムフレームワークを使用しています。第三者ライセンスはソース配布物に記載しています。" } } } },
    "help.file.format.body" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The native .inkpod format stores a versioned manifest and checked binary assets. This milestone does not change its format or replay semantics." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ネイティブ.inkpod形式はversion付きmanifestと検査済みbinary assetを保存します。このマイルストーンでは形式とreplay semanticsを変更していません。" } } } },
    "help.manual.body" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Draw on the canvas with the primary pointer. Use View commands for zoom, flips, guides, and grid controls. Keyboard shortcuts can be reviewed and edited in Settings." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "主ポインタでキャンバスへ描画できます。表示メニューからズーム、表示反転、ガイド、グリッドを操作できます。ショートカットは設定で確認・編集できます。" } } } },
