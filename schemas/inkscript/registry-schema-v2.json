{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inkpod.invalid/schemas/inkscript/registry-schema-v2.json",
  "title": "InkScript registry schema v2",
  "unevaluatedProperties": false,
  "oneOf": [
    { "$ref": "#/$defs/language_registry" },
    { "$ref": "#/$defs/catalog_registry" },
    { "$ref": "#/$defs/owner_manifest" }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "minLength": 1,
      "maxLength": 128
    },
    "type_ref": {
      "type": "string",
      "pattern": "^(list<|nullable<)*[a-z][a-z0-9_]*(>)*$",
      "minLength": 1,
      "maxLength": 256
    },
    "string_array": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "required", "default", "canonical_order", "constraints"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "type": { "$ref": "#/$defs/type_ref" },
        "required": { "type": "boolean" },
        "default": {},
        "canonical_order": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "constraints": { "$ref": "#/$defs/string_array" }
      }
    },
    "builtin_type": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "constraints"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "kind": {
          "enum": ["bool", "unsigned_integer", "signed_integer", "q16", "string", "uuid", "digest", "base64", "reference"]
        },
        "constraints": { "$ref": "#/$defs/string_array" }
      }
    },
    "enum_type": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "members"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "members": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "constructor_argument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "constraints"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "type": { "$ref": "#/$defs/type_ref" },
        "constraints": { "$ref": "#/$defs/string_array" }
      }
    },
    "constructor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "result", "arguments", "conversion"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "result": { "$ref": "#/$defs/type_ref" },
        "arguments": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/constructor_argument" }
        },
        "conversion": { "enum": ["exact", "decimal_q16_ties_even"] }
      }
    },
    "record_type": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "fields"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "fields": {
          "type": "array",
          "maxItems": 65536,
          "items": { "$ref": "#/$defs/field" }
        }
      }
    },
    "grammar_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "ebnf", "references"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "ebnf": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "references": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "grammar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keywords", "escapes", "rules"],
      "properties": {
        "keywords": { "$ref": "#/$defs/string_array" },
        "escapes": { "$ref": "#/$defs/string_array" },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/grammar_rule" }
        }
      }
    },
    "canonicalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "bom", "newline", "indent_spaces", "final_newline", "section_order", "record_field_order", "decimal_rounding", "q16_emission"],
      "properties": {
        "encoding": { "const": "utf-8" },
        "bom": { "const": false },
        "newline": { "const": "lf" },
        "indent_spaces": { "const": 4 },
        "final_newline": { "const": true },
        "section_order": { "$ref": "#/$defs/string_array" },
        "record_field_order": { "const": "canonical_order" },
        "decimal_rounding": { "const": "exact-rational-then-ties-to-even" },
        "q16_emission": { "const": "q16(raw_i64)" }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "body_type", "allowed_in", "required_in", "declaration_order_semantic"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "body_type": { "$ref": "#/$defs/type_ref" },
        "allowed_in": {
          "type": "array",
          "items": { "enum": ["file", "fragment"] },
          "uniqueItems": true
        },
        "required_in": {
          "type": "array",
          "items": { "enum": ["file", "fragment"] },
          "uniqueItems": true
        },
        "declaration_order_semantic": { "type": "boolean" }
      }
    },
    "input_kind": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "options_type", "expansion"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "path": { "enum": ["required", "forbidden"] },
        "options_type": { "$ref": "#/$defs/type_ref" },
        "expansion": { "enum": ["single_file", "folder_children", "captured_document", "captured_sequence"] }
      }
    },
    "selector_entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "reference_type", "owner", "initial_order", "filters"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "reference_type": { "$ref": "#/$defs/type_ref" },
        "owner": { "enum": ["document", "layer", "plane", "light_table_set"] },
        "initial_order": { "enum": ["document_tree", "guide_order", "singleton", "light_table_order"] },
        "filters": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/field" }
        }
      }
    },
    "assert_kind": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "fields", "comparison", "failure"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/field" }
        },
        "comparison": { "enum": ["exact_typed_field_equality", "exact_object_property_equality", "exact_selection_state_equality"] },
        "failure": { "const": "item_failure_without_mutation" }
      }
    },
    "numeric_literal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "value"],
      "properties": {
        "op": { "const": "u64" },
        "value": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 }
      }
    },
    "numeric_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "path", "type"],
      "properties": {
        "op": { "const": "field" },
        "path": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/identifier" } },
        "type": { "enum": ["u32", "u64", "i32", "i64"] }
      }
    },
    "numeric_list_length": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "path", "maximum"],
      "properties": {
        "op": { "const": "list_length" },
        "path": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/identifier" } },
        "maximum": { "type": "integer", "minimum": 0, "maximum": 4194304 }
      }
    },
    "numeric_binary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "left", "right"],
      "properties": {
        "op": { "enum": ["checked_add", "checked_subtract", "checked_multiply", "ceil_divide_nonzero", "min", "max"] },
        "left": { "$ref": "#/$defs/numeric_expression" },
        "right": { "$ref": "#/$defs/numeric_expression" }
      }
    },
    "numeric_abs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "value"],
      "properties": {
        "op": { "const": "checked_abs" },
        "value": { "$ref": "#/$defs/numeric_expression" }
      }
    },
    "numeric_sum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "path", "maximum_items", "body"],
      "properties": {
        "op": { "const": "bounded_sum" },
        "path": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/identifier" } },
        "maximum_items": { "type": "integer", "minimum": 0, "maximum": 4194304 },
        "body": { "$ref": "#/$defs/numeric_expression" }
      }
    },
    "numeric_conditional": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "condition", "when_true", "when_false"],
      "properties": {
        "op": { "const": "conditional" },
        "condition": { "$ref": "#/$defs/boolean_expression" },
        "when_true": { "$ref": "#/$defs/numeric_expression" },
        "when_false": { "$ref": "#/$defs/numeric_expression" }
      }
    },
    "numeric_expression": {
      "oneOf": [
        { "$ref": "#/$defs/numeric_literal" },
        { "$ref": "#/$defs/numeric_field" },
        { "$ref": "#/$defs/numeric_list_length" },
        { "$ref": "#/$defs/numeric_binary" },
        { "$ref": "#/$defs/numeric_abs" },
        { "$ref": "#/$defs/numeric_sum" },
        { "$ref": "#/$defs/numeric_conditional" }
      ]
    },
    "boolean_literal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "value"],
      "properties": {
        "op": { "const": "bool" },
        "value": { "type": "boolean" }
      }
    },
    "boolean_compare": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "left", "right"],
      "properties": {
        "op": { "enum": ["equal", "not_equal", "less", "less_equal", "greater", "greater_equal"] },
        "left": { "$ref": "#/$defs/numeric_expression" },
        "right": { "$ref": "#/$defs/numeric_expression" }
      }
    },
    "boolean_binary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "left", "right"],
      "properties": {
        "op": { "enum": ["and", "or"] },
        "left": { "$ref": "#/$defs/boolean_expression" },
        "right": { "$ref": "#/$defs/boolean_expression" }
      }
    },
    "boolean_not": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "value"],
      "properties": {
        "op": { "const": "not" },
        "value": { "$ref": "#/$defs/boolean_expression" }
      }
    },
    "boolean_expression": {
      "oneOf": [
        { "$ref": "#/$defs/boolean_literal" },
        { "$ref": "#/$defs/boolean_compare" },
        { "$ref": "#/$defs/boolean_binary" },
        { "$ref": "#/$defs/boolean_not" }
      ]
    },
    "portability_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "required_preconditions"],
      "properties": {
        "class": { "enum": ["portable", "requires_binding", "strict_source_only"] },
        "required_preconditions": { "$ref": "#/$defs/string_array" }
      }
    },
    "portability_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when", "result"],
      "properties": {
        "when": { "$ref": "#/$defs/boolean_expression" },
        "result": { "$ref": "#/$defs/portability_result" }
      }
    },
    "portability_evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules", "default"],
      "properties": {
        "rules": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/portability_rule" } },
        "default": { "$ref": "#/$defs/portability_result" }
      }
    },
    "work_formula": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_invocations", "max_output_ids", "max_asset_bytes", "max_work_units", "max_output_growth"],
      "properties": {
        "max_invocations": { "$ref": "#/$defs/numeric_expression" },
        "max_output_ids": { "$ref": "#/$defs/numeric_expression" },
        "max_asset_bytes": { "$ref": "#/$defs/numeric_expression" },
        "max_work_units": { "$ref": "#/$defs/numeric_expression" },
        "max_output_growth": { "$ref": "#/$defs/numeric_expression" }
      }
    },
    "asset_kind": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "descriptor_type", "logical_layout", "length_formula", "inline", "external"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "descriptor_type": { "$ref": "#/$defs/type_ref" },
        "logical_layout": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "length_formula": { "$ref": "#/$defs/numeric_expression" },
        "inline": { "type": "boolean" },
        "external": { "type": "boolean" }
      }
    },
    "resource_limit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "maximum", "unit", "environment_cap"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "maximum": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
        "unit": { "enum": ["bytes", "items", "depth", "milliseconds", "work_units"] },
        "environment_cap": { "type": ["string", "null"], "maxLength": 256 }
      }
    },
    "id_namespace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "order"],
      "properties": {
        "tag": { "$ref": "#/$defs/identifier" },
        "order": { "type": "integer", "minimum": 0, "maximum": 65535 }
      }
    },
    "language_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "registry_schema_version", "file_version", "procedure_catalog_version", "required_replay_epoch", "canonicalization", "grammar", "types", "enums", "constructors", "records", "sections", "input_kinds", "selector_entities", "assert_kinds", "asset_kinds", "persistent_id_namespaces", "resource_limits"],
      "properties": {
        "kind": { "const": "inkpod.inkscript.language" },
        "registry_schema_version": { "const": 2 },
        "file_version": { "type": "integer", "minimum": 1 },
        "procedure_catalog_version": { "type": "integer", "minimum": 1 },
        "required_replay_epoch": { "type": "integer", "minimum": 1 },
        "canonicalization": { "$ref": "#/$defs/canonicalization" },
        "grammar": { "$ref": "#/$defs/grammar" },
        "types": { "type": "array", "items": { "$ref": "#/$defs/builtin_type" } },
        "enums": { "type": "array", "items": { "$ref": "#/$defs/enum_type" } },
        "constructors": { "type": "array", "items": { "$ref": "#/$defs/constructor" } },
        "records": { "type": "array", "items": { "$ref": "#/$defs/record_type" } },
        "sections": { "type": "array", "items": { "$ref": "#/$defs/section" } },
        "input_kinds": { "type": "array", "items": { "$ref": "#/$defs/input_kind" } },
        "selector_entities": { "type": "array", "items": { "$ref": "#/$defs/selector_entity" } },
        "assert_kinds": { "type": "array", "items": { "$ref": "#/$defs/assert_kind" } },
        "asset_kinds": { "type": "array", "items": { "$ref": "#/$defs/asset_kind" } },
        "persistent_id_namespaces": { "type": "array", "items": { "$ref": "#/$defs/id_namespace" } },
        "resource_limits": { "type": "array", "items": { "$ref": "#/$defs/resource_limit" } }
      }
    },
    "command_argument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "required", "default", "nullable", "bound", "canonical_order", "stable_id_role", "asset_role"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "type": { "$ref": "#/$defs/type_ref" },
        "required": { "type": "boolean" },
        "default": {},
        "nullable": { "type": "boolean" },
        "bound": { "$ref": "#/$defs/string_array" },
        "canonical_order": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "stable_id_role": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/stable_id_role" }
          ]
        },
        "asset_role": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/asset_role" }
          ]
        }
      }
    },
    "stable_id_role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "namespace", "cardinality"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "namespace": { "$ref": "#/$defs/identifier" },
        "cardinality": { "enum": ["scalar", "ordered_list"] }
      }
    },
    "asset_role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "inline", "external"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "kind": { "$ref": "#/$defs/identifier" },
        "inline": { "type": "boolean" },
        "external": { "type": "boolean" }
      }
    },
    "command_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "availability", "cardinality", "namespace", "owner_role", "output_id_ordinal", "canonical_order"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "type": { "$ref": "#/$defs/type_ref" },
        "availability": { "enum": ["always_on_success", "only_on_change"] },
        "cardinality": { "enum": ["scalar", "fixed_tuple", "ordered_list"] },
        "namespace": { "type": ["string", "null"], "maxLength": 128 },
        "owner_role": { "type": ["string", "null"], "maxLength": 128 },
        "output_id_ordinal": { "type": ["integer", "null"], "minimum": 0, "maximum": 65535 },
        "canonical_order": { "type": "integer", "minimum": 0, "maximum": 65535 }
      }
    },
    "editor_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "legacy_projection", "allow_skip_dependents"],
      "properties": {
        "family": { "$ref": "#/$defs/identifier" },
        "legacy_projection": { "type": ["string", "null"], "maxLength": 128 },
        "allow_skip_dependents": { "type": "boolean" }
      }
    },
    "command_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "primitive_id", "primitive_schema_version", "replay_epoch", "semantics_revision", "arguments", "results", "portability", "work", "cancellation_boundary", "editor", "owner_milestone", "equivalence_test"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "primitive_id": { "type": "string", "pattern": "^0x[0-9a-f]{8}$" },
        "primitive_schema_version": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "replay_epoch": { "type": "integer", "minimum": 1 },
        "semantics_revision": { "type": "integer", "minimum": 1 },
        "arguments": { "type": "array", "items": { "$ref": "#/$defs/command_argument" } },
        "results": { "type": "array", "items": { "$ref": "#/$defs/command_result" } },
        "portability": { "$ref": "#/$defs/portability_evaluator" },
        "work": { "$ref": "#/$defs/work_formula" },
        "cancellation_boundary": { "enum": ["before_primitive", "bounded_work_chunk", "noncancellable_primitive"] },
        "editor": { "$ref": "#/$defs/editor_metadata" },
        "owner_milestone": { "type": "string", "pattern": "^M(0[7-9]|1[5-9]|2[0-2])[AB]?$" },
        "equivalence_test": { "type": "string", "pattern": "^INKS-EQ-[0-9]{4}$" }
      }
    },
    "catalog_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "registry_schema_version", "file_version", "catalog_version", "required_replay_epoch", "production", "enums", "constructors", "records", "entries"],
      "properties": {
        "kind": { "enum": ["inkpod.inkscript.catalog-draft", "inkpod.inkscript.catalog"] },
        "registry_schema_version": { "const": 2 },
        "file_version": { "type": "integer", "minimum": 1 },
        "catalog_version": { "type": "integer", "minimum": 1 },
        "required_replay_epoch": { "type": "integer", "minimum": 1 },
        "production": { "type": "boolean" },
        "enums": { "type": "array", "items": { "$ref": "#/$defs/enum_type" } },
        "constructors": { "type": "array", "items": { "$ref": "#/$defs/constructor" } },
        "records": { "type": "array", "items": { "$ref": "#/$defs/record_type" } },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/command_entry" } }
      }
    },
    "replay_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inkscript_file_version", "procedure_catalog_version", "replay_epoch", "inkpod_top_level_version", "c_abi_version"],
      "properties": {
        "inkscript_file_version": { "type": "integer", "minimum": 1 },
        "procedure_catalog_version": { "type": "integer", "minimum": 1 },
        "replay_epoch": { "type": "integer", "minimum": 1 },
        "inkpod_top_level_version": { "type": "integer", "minimum": 1 },
        "c_abi_version": { "type": "integer", "minimum": 1 }
      }
    },
    "owner_assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primitive_rust", "primitive_id", "canonical_name", "primitive_schema_version", "semantics_revision", "command_name", "owner_milestone", "planned_equivalence_test"],
      "properties": {
        "primitive_rust": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "primitive_id": { "type": "string", "pattern": "^0x[0-9a-f]{8}$" },
        "canonical_name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "primitive_schema_version": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "semantics_revision": { "type": "integer", "minimum": 1 },
        "command_name": { "$ref": "#/$defs/identifier" },
        "owner_milestone": { "type": "string", "pattern": "^M(0[7-9]|1[5-9]|2[0-2])[AB]?$" },
        "planned_equivalence_test": { "type": "string", "pattern": "^INKS-EQ-[0-9]{4}$" }
      }
    },
    "excluded_primitive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primitive_rust", "primitive_id", "canonical_name", "reason"],
      "properties": {
        "primitive_rust": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "primitive_id": { "type": "string", "pattern": "^0x[0-9a-f]{8}$" },
        "canonical_name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "reason": { "enum": ["session_only", "query", "view", "preview", "export", "history_control"] }
      }
    },
    "traceability_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_requirement", "script_requirements", "milestones", "evidence_tests"],
      "properties": {
        "batch_requirement": { "type": "string", "pattern": "^BATCH-[0-9]{3}$" },
        "script_requirements": { "$ref": "#/$defs/string_array" },
        "milestones": { "$ref": "#/$defs/string_array" },
        "evidence_tests": { "$ref": "#/$defs/string_array" }
      }
    },
    "owner_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "registry_schema_version", "replay_contract", "owners", "excluded_primitives", "batch_traceability"],
      "properties": {
        "kind": { "const": "inkpod.inkscript.owner-manifest" },
        "registry_schema_version": { "const": 2 },
        "replay_contract": { "$ref": "#/$defs/replay_contract" },
        "owners": { "type": "array", "items": { "$ref": "#/$defs/owner_assignment" } },
        "excluded_primitives": { "type": "array", "items": { "$ref": "#/$defs/excluded_primitive" } },
        "batch_traceability": { "type": "array", "items": { "$ref": "#/$defs/traceability_entry" } }
      }
    }
  }
}
