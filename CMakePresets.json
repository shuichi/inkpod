{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64-debug",
      "displayName": "Windows x64 Debug (MSVC + Ninja)",
      "description": "Requires an x64-initialized MSVC developer environment; CMake rejects any other target architecture.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-x64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "INKPOD_WINDOWS_ARCHITECTURE": "x64"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-x64-release",
      "displayName": "Windows x64 Release (MSVC + Ninja)",
      "description": "Requires an x64-initialized MSVC developer environment; CMake rejects any other target architecture.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-x64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "INKPOD_WINDOWS_ARCHITECTURE": "x64"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-arm-debug",
      "displayName": "Windows ARM64 Debug (MSVC + Ninja)",
      "description": "Requires an ARM64-initialized MSVC developer environment and the aarch64-pc-windows-msvc Rust target.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-arm-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "INKPOD_WINDOWS_ARCHITECTURE": "arm64"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-arm-release",
      "displayName": "Windows ARM64 Release (MSVC + Ninja)",
      "description": "Requires an ARM64-initialized MSVC developer environment and the aarch64-pc-windows-msvc Rust target.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-arm-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "INKPOD_WINDOWS_ARCHITECTURE": "arm64"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "macos-arm64-debug",
      "displayName": "macOS arm64 Debug (CMake + Cargo + Xcode)",
      "description": "Builds the Rust static library and invokes the checked-in Xcode project only through CMake.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/macos-arm64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-universal-release",
      "displayName": "macOS Universal 2 Release (CMake + Cargo + Xcode)",
      "description": "Builds separate arm64/x86_64 Rust archives, merges them with lipo, and links the Universal Swift ABI smoke.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/macos-universal-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64-debug"
    },
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64-release"
    },
    {
      "name": "windows-arm-debug",
      "configurePreset": "windows-arm-debug"
    },
    {
      "name": "windows-arm-release",
      "configurePreset": "windows-arm-release"
    },
    {
      "name": "macos-arm64-debug",
      "configurePreset": "macos-arm64-debug"
    },
    {
      "name": "macos-universal-release",
      "configurePreset": "macos-universal-release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-arm-debug",
      "configurePreset": "windows-arm-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-arm-release",
      "configurePreset": "windows-arm-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-arm64-debug",
      "configurePreset": "macos-arm64-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
